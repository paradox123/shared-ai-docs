{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:danielsvault:github-issue-pilot:worker-result:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome", "summary", "red_green_slices", "changed_files", "verification", "evidence", "findings"],
  "properties": {
    "schema_version": {"const": "1"},
    "outcome": {"enum": ["completed", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "red_green_slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "red", "green"],
        "properties": {
          "requirement": {"type": "string", "minLength": 1},
          "red": {"$ref": "#/$defs/observation"},
          "green": {"$ref": "#/$defs/observation"}
        }
      }
    },
    "changed_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "proof"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "proof": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "observed"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1}
      }
    }
  }
}
