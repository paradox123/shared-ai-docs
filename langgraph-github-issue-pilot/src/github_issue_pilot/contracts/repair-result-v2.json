{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:danielsvault:github-issue-pilot:repair-result:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repair_batch_id", "round_number", "outcome", "summary", "implementation_result", "remaining_findings", "blockage", "escalation_reason", "terminal_disposition", "intervention"],
  "properties": {
    "schema_version": {"type": "string", "const": "2"},
    "repair_batch_id": {"type": "string", "minLength": 1},
    "round_number": {"type": "integer", "minimum": 1, "maximum": 3},
    "outcome": {"type": "string", "enum": ["completed", "blocked", "escalate", "intervention"]},
    "summary": {"type": "string", "minLength": 1},
    "implementation_result": {"type": ["object", "null"]},
    "remaining_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "blockage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "rationale"],
          "properties": {
            "reason": {"type": "string", "enum": ["product_decision", "scope_expansion", "missing_access", "manual_evidence", "requirements_missing_or_contradictory", "unresolvable_conflict"]},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "escalation_reason": {"type": ["string", "null"], "enum": [null, "architecture_boundary", "persistence_boundary", "security_boundary", "data_migration", "worker_escalate"]},
    "terminal_disposition": {"type": ["string", "null"], "enum": [null, "needs-info", "ready-for-human"]},
    "intervention": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/intervention_request"}]}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "completed"}}}, "then": {"properties": {"implementation_result": {"type": "object"}, "blockage": {"type": "null"}, "escalation_reason": {"type": "null"}, "intervention": {"type": "null"}}}},
    {"if": {"properties": {"outcome": {"const": "blocked"}}}, "then": {"properties": {"implementation_result": {"type": "null"}, "blockage": {"type": "object"}, "escalation_reason": {"type": "null"}, "terminal_disposition": {"type": "string", "enum": ["needs-info", "ready-for-human"]}, "intervention": {"type": "null"}}}},
    {"if": {"properties": {"outcome": {"const": "escalate"}}}, "then": {"properties": {"implementation_result": {"type": "null"}, "blockage": {"type": "null"}, "escalation_reason": {"type": "string"}, "terminal_disposition": {"type": "null"}, "intervention": {"type": "null"}}}},
    {"if": {"properties": {"outcome": {"const": "intervention"}}}, "then": {"properties": {"implementation_result": {"type": "null"}, "blockage": {"type": "null"}, "escalation_reason": {"type": "null"}, "terminal_disposition": {"type": "null"}, "intervention": {"$ref": "#/$defs/intervention_request"}}}}
  ],
  "$defs": {
    "finding": {"type": "object", "additionalProperties": false, "required": ["source", "axis", "location", "description"], "properties": {"source": {"type": "string", "enum": ["review", "deterministic_verification", "repair"]}, "axis": {"type": "string", "enum": ["requirements", "code", "architecture", "deterministic_verification", "repair"]}, "location": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "intervention_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "repository", "run", "role", "context", "classification", "problem", "required_action", "options", "recommendation", "preserved"],
      "properties": {
        "schema_version": {"type": "string", "const": "1"},
        "repository": {"type": "object", "additionalProperties": false, "required": ["full_name", "issue_number"], "properties": {"full_name": {"type": "string", "minLength": 1}, "issue_number": {"type": "integer", "minimum": 1}}},
        "run": {"type": "object", "additionalProperties": false, "required": ["id", "phase", "operation_key"], "properties": {"id": {"type": "string", "minLength": 1}, "phase": {"type": "string", "enum": ["implementation", "review", "repair"]}, "operation_key": {"type": "string", "minLength": 1}}},
        "role": {"type": "string", "enum": ["implementer", "requirements_reviewer", "code_reviewer", "architecture_reviewer", "repairer"]},
        "context": {"type": "object", "additionalProperties": false, "required": ["worktree_path", "branch", "pull_request_number", "head_sha"], "properties": {"worktree_path": {"type": ["string", "null"], "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "pull_request_number": {"type": ["integer", "null"], "minimum": 1}, "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}}},
        "classification": {"type": "string", "enum": ["product_decision", "scope_expansion", "missing_access", "manual_evidence", "requirements_missing_or_contradictory", "unresolvable_conflict", "repair_rounds_exhausted"]},
        "problem": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label", "impact"], "properties": {"label": {"type": "string", "minLength": 1}, "impact": {"type": "string", "minLength": 1}}}},
        "recommendation": {"type": "object", "additionalProperties": false, "required": ["option_label", "rationale"], "properties": {"option_label": {"type": ["string", "null"], "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}},
        "preserved": {"type": "object", "additionalProperties": false, "required": ["findings", "results"], "properties": {"findings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "results": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
      }
    }
  }
}
