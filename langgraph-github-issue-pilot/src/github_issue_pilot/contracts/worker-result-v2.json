{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:danielsvault:github-issue-pilot:worker-result:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "summary",
    "red_green_slices",
    "changed_files",
    "verification",
    "evidence",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2"},
    "outcome": {"type": "string", "enum": ["completed", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "red_green_slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "red", "green"],
        "properties": {
          "requirement": {"type": "string", "minLength": 1},
          "red": {"$ref": "#/$defs/command_observation"},
          "green": {"$ref": "#/$defs/command_observation"}
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verification": {
      "type": "array",
      "items": {"$ref": "#/$defs/command_observation"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence_item"}
    },
    "findings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "command_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "observed"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1}
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "verdict",
        "kind",
        "observed_interface",
        "expected_result",
        "observations"
      ],
      "properties": {
        "criterion": {"type": "string", "minLength": 1},
        "verdict": {"type": "string", "enum": ["pass", "fail"]},
        "kind": {
          "type": "string",
          "enum": [
            "rest",
            "ui",
            "recovery",
            "idempotency",
            "negative_gate",
            "background",
            "document"
          ]
        },
        "observed_interface": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_observation"}
        }
      }
    },
    "evidence_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "description", "artifact", "correlation_id"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "request",
            "response",
            "read_back",
            "interaction",
            "screenshot",
            "restart",
            "repeat",
            "rejection",
            "side_effect_read_back",
            "eventual_result",
            "log"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "artifact": {"type": ["string", "null"]},
        "correlation_id": {"type": ["string", "null"]}
      }
    }
  }
}
