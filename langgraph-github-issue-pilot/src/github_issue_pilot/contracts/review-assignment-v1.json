{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:danielsvault:github-issue-pilot:review-assignment:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_id",
    "axis",
    "scope",
    "pull_request",
    "requirements",
    "implementation",
    "evidence",
    "repository_context"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "invocation_id": {"type": "string", "minLength": 1},
    "axis": {"enum": ["requirements", "code", "architecture"]},
    "scope": {"type": "string", "minLength": 1},
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url", "base_ref", "head_ref", "head_sha"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "minLength": 1},
        "base_ref": {"type": "string", "minLength": 1},
        "head_ref": {"type": "string", "minLength": 1},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "changed_files", "verification"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "changed_files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "verification": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "repository_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": {"type": "string", "minLength": 1}
      }
    }
  }
}
