{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:danielsvault:github-issue-pilot:review-verdict:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_id",
    "axis",
    "head_sha",
    "verdict",
    "rationale",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "invocation_id": {"type": "string", "minLength": 1},
    "axis": {"enum": ["requirements", "code", "architecture"]},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verdict": {"enum": ["pass", "fail", "not_applicable"]},
    "rationale": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "description"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "fail"}}},
      "then": {"properties": {"findings": {"minItems": 1}}}
    }
  ]
}
