# Copy to ~/.config/danielsvault-github-issue-pilot/pilot.env, fill in private
# values, and chmod 600. Never commit the completed file.

PILOT_EXECUTABLE='/absolute/path/to/github-issue-pilot'
CLOUDFLARED_EXECUTABLE='/absolute/path/to/cloudflared'
CLOUDFLARED_CONFIG='/Users/your-user/.cloudflared/danielsvault-github-pilot.yml'
CLOUDFLARED_TUNNEL_NAME='danielsvault-github-pilot'
PILOT_PUBLIC_RECEIVER_URL='https://github-pilot.example.com/webhooks/github'
PILOT_HOST='127.0.0.1'
PILOT_PORT='8788'

PILOT_ALLOWED_REPOSITORIES='your-owner/probare-crm'
GITHUB_TOKEN='replace-with-private-token'
DANIEL_GITHUB_LOGIN='replace-with-github-login'
PILOT_REPOSITORY_ROOT='/absolute/path/to/probare-crm'
PILOT_WORKTREE_ROOT='/absolute/disjoint/path/to/pilot-worktrees'
PILOT_REPOSITORY_CONTEXT_PATH='/absolute/path/to/private-repository-context.md'
PILOT_PUBLIC_OBSERVATION_SURFACE='http://127.0.0.1:8788'
PILOT_VERIFICATION_COMMAND='replace-with-repository-verification-command'
PILOT_SKILL_ROOT='/absolute/path/to/skills'
PILOT_DATABASE_PATH='/Users/your-user/Library/Application Support/DanielsVault GitHub Issue Pilot/pilot.db'
PILOT_INTERNAL_WEBHOOK_SECRET='replace-with-private-internal-secret'
GITHUB_WEBHOOK_SECRET=''

# Optional production overrides:
# PILOT_BASE_REF='main'
# PILOT_CODEX_EXECUTABLE='/absolute/path/to/codex'
# PILOT_CODEX_TIMEOUT_SECONDS='3600'
# PILOT_GIT_EXECUTABLE='/usr/bin/git'
# PILOT_MAX_REQUEST_BYTES='1048576'
