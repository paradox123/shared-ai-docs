{
  "name": "@danielsvault/cloudflare-github-webhook-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types:check && npm run lint && npm test",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "lint": "oxlint --type-aware -D typescript/no-floating-promises src test vitest.config.ts",
    "test": "vitest run",
    "types": "wrangler types",
    "types:check": "wrangler types --check && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "latest",
    "@msw/cloudflare": "latest",
    "msw": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
