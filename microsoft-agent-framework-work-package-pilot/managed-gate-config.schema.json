{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danielsvault.local/schemas/maf-managed-dts-gate-v1.json",
  "title": "Microsoft Agent Framework managed DTS pilot gate configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorApproval", "azure", "packages", "provenance", "probe"],
  "properties": {
    "schemaVersion": { "const": "maf-managed-dts-gate/v1" },
    "operatorApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "acceptedAt", "scope"],
      "properties": {
        "accepted": { "const": true },
        "acceptedAt": { "type": "string", "format": "date" },
        "scope": { "const": "isolated-agent-framework-pilot" }
      }
    },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subscriptionId", "tenantId", "resourceGroup", "schedulerName", "taskHubName", "endpoint", "authentication", "developerPrincipalObjectId", "budgetName", "budgetAmount", "ipAllowlist", "connectionEnvFile"],
      "properties": {
        "subscriptionId": { "type": "string", "format": "uuid" },
        "tenantId": { "type": "string", "format": "uuid" },
        "resourceGroup": { "type": "string", "minLength": 1 },
        "schedulerName": { "type": "string", "minLength": 1 },
        "taskHubName": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "format": "uri" },
        "authentication": { "const": "DefaultAzure" },
        "developerPrincipalObjectId": { "type": "string", "format": "uuid" },
        "budgetName": { "type": "string", "minLength": 1 },
        "budgetAmount": { "const": 5 },
        "ipAllowlist": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "connectionEnvFile": { "type": "string", "minLength": 1 }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["azureIdentity", "agentFrameworkDurableTask", "agentFrameworkWorkflows", "durableTask"],
      "properties": {
        "azureIdentity": { "const": "1.17.1" },
        "agentFrameworkDurableTask": { "const": "1.16.0-preview.260730.1" },
        "agentFrameworkWorkflows": { "const": "1.16.0" },
        "durableTask": { "const": "1.18.0" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRevision", "dotnetSdk", "rid", "packageLockPath", "packageLockSha256", "pilotSourceSha256", "protectedBoundariesSha256", "contractVersion"],
      "properties": {
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dotnetSdk": { "const": "10.0.203" },
        "rid": { "const": "osx-arm64" },
        "packageLockPath": { "const": "ManagedDurabilityProbe/packages.lock.json" },
        "packageLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pilotSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "protectedBoundariesSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contractVersion": { "const": "v1" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "expectedEffects", "workerNames", "entryTimeoutSeconds", "completionTimeoutSeconds"],
      "properties": {
        "command": { "const": ["dotnet", "run", "--no-build", "--project", "ManagedDurabilityProbe", "--"] },
        "expectedEffects": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "workerNames": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "entryTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "completionTimeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
