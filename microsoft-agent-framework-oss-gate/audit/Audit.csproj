<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.DurableTask" Version="1.16.0-preview.260730.1" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.16.0" />
    <PackageReference Include="Microsoft.DurableTask.Client" Version="1.18.0" />
    <PackageReference Include="Microsoft.DurableTask.Client.AzureManaged" Version="1.18.0" />
    <PackageReference Include="Microsoft.DurableTask.Worker" Version="1.18.0" />
    <PackageReference Include="Microsoft.DurableTask.Worker.AzureManaged" Version="1.18.0" />
  </ItemGroup>
</Project>
