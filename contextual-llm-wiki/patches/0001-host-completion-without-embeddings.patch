+/** Adapt tool schemas to the strict object contract required by Codex output-schema.
+ * Optional fields are supplied explicitly (empty arrays are valid); original AJV
+ * validation still checks the returned result against the caller's contract.
+ */
+function codexStructuredSchema(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(codexStructuredSchema);
+  if (!value || typeof value !== "object") return value;
+  const schema = Object.fromEntries(Object.entries(value).map(([key, child]) => [key, codexStructuredSchema(child)]));
+  if (schema.type === "object" && schema.properties) {
+    schema.additionalProperties = false;
+    schema.required = Object.keys(schema.properties as Record<string, unknown>);
+  }
+  return schema;
+}
