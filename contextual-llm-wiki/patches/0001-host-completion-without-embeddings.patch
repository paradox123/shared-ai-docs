new file mode 100644
index 0000000..9836367
--- /dev/null
+++ b/src/sdk/completion.ts
@@ -0,0 +1,8 @@
+import { callClaude } from "../utils/llm.js";
+import { ensureProviderAvailable } from "../utils/provider-guard.js";
+import { withQuiet } from "../utils/output.js";
+/** Complete only the supplied evidence; the host owns retrieval and save policy. */
+export async function completeText(input: { system: string; prompt: string; maxTokens?: number }): Promise<string> {
+  ensureProviderAvailable({ embeddings: false });
+  return withQuiet(() => callClaude({system: input.system, messages: [{role: "user", content: input.prompt}], maxTokens: input.maxTokens}));
+}
