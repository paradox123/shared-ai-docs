{
  "name": "contextual-llm-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "./wiki-node --test test/*.test.ts",
    "typecheck": "./wiki-node node_modules/typescript/bin/tsc",
    "test:upstream": "./scripts/verify-upstream.sh",
    "check": "npm run typecheck && npm test && npm run test:upstream && npm run test:operations",
    "test:operations": "python3 -m unittest discover -s test -p 'test_maintenance_*.py'"
  },
  "engines": {
    "node": "24.16.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.3",
    "minimatch": "^10.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
